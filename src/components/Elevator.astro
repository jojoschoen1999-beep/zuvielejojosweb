---
// Pixel-art elevator for the elevator pitch section.
// Doors start closed and open 1s after the elevator scrolls into view.
import { elevatorPitch, underConstruction } from '../data/elevatorPitch';

const floors = elevatorPitch.map(({ heading, subheading, text, image, imageAlt }) => ({ heading, subheading, text, image, imageAlt }));
---

<div class="elev" data-elevator data-floors={JSON.stringify(floors)} data-wip={underConstruction ? '1' : '0'}>
  <div class="elev-left">
    <div class="elev-stage" data-stage>
      <canvas width="96" height="84" aria-label="Pixel elevator" data-canvas></canvas>
      <div class="elev-room" data-room aria-live="polite"></div>
      <button class="elev-hit" type="button" data-call="1" aria-label={underConstruction ? 'Open or close the doors' : 'Go up'}></button>
      <button class="elev-hit" type="button" data-call="-1" aria-label={underConstruction ? 'Open or close the doors' : 'Go down'}></button>
    </div>
    {!underConstruction && (
      <div class="elev-ctrls">
        <button class="chip" type="button" data-dir="-1">▼ down</button>
        <button class="chip" type="button" data-dir="1">▲ up</button>
        <span class="elev-status" data-status>floor 1</span>
      </div>
    )}
  </div>

  {underConstruction ? (
    <div class="col elev-panel">
      <span class="lbl">under construction</span>
      <div class="win">
        <div class="bar"><span>elevator.pitch 0.1</span><span>▢</span></div>
        <div class="bd">
          <span>Loading ...</span>
          <span>floor 0 of {floors.length}</span>
          <div class="prog" aria-hidden="true"><i style="width:12%">12%</i></div>
        </div>
      </div>
      <p class="lede">this page is still being built. come back soon.</p>
    </div>
  ) : (
    <div class="col elev-panel" data-panel>
      <span class="lbl" data-p-sub></span>
      <h3 class="h2" data-p-head></h3>
      <p data-p-text></p>
      <div class="win">
        <div class="bar"><span data-p-file></span><span>▢</span></div>
        <div class="bd"><div class="elev-shot" data-p-pic></div></div>
      </div>
    </div>
  )}
</div>

<script>
  type Floor = { heading: string; subheading: string; text: string; image: string; imageAlt: string };

  const C = { ink: '#1E1E1E', paper: '#FEFEFE', yel: '#FFFCB8', yel2: '#EDE79C', pink: '#F386A1', pink2: '#DC6E8C',
    g1: '#F1F2F4', g2: '#DADCE0', g3: '#B8BBC1', g4: '#8E9299', g5: '#62666D' };
  const DIG: Record<number, string[]> = {
    0: ['111','101','101','101','111'], 1: ['010','110','010','010','111'], 2: ['111','001','111','100','111'],
    3: ['111','001','111','001','111'], 4: ['101','101','111','001','001'], 5: ['111','100','111','001','111'],
    6: ['111','100','111','101','111'], 7: ['111','001','010','010','010'], 8: ['111','101','111','101','111'], 9: ['111','101','111','001','111'],
  };
  const UP = ['00100','01110','11111'], DOWN = ['11111','01110','00100'];
  const D: [number, number, number, number] = [28, 20, 40, 54]; // doorway x, y, w, h in pixels
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise(r => setTimeout(r, reduce ? 0 : ms));
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  // Timer-driven (not requestAnimationFrame) so the doors always finish moving,
  // even when the browser pauses animation frames. ~30fps suits the pixel look.
  function tween(dur: number, step: (k: number) => void) {
    return new Promise<void>(res => {
      if (reduce) { step(1); return res(); }
      const t0 = performance.now();
      const f = () => { const k = Math.min(1, (performance.now() - t0) / dur); step(k); k < 1 ? setTimeout(f, 33) : res(); };
      f();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-elevator]').forEach((root) => {
    const floors: Floor[] = JSON.parse(root.dataset.floors || '[]');
    const wip = root.dataset.wip === '1';
    const N = floors.length;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const cv = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const g = cv.getContext('2d')!;
    const room = root.querySelector<HTMLElement>('[data-room]')!;
    const calls = root.querySelectorAll<HTMLButtonElement>('[data-call]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const panel = root.querySelector<HTMLElement>('[data-panel]');
    const dirBtns = root.querySelectorAll<HTMLButtonElement>('[data-dir]');

    let cur = 0, open = 0, dir = 0, busy = true, pressed = 0;

    const px = (x: number, y: number, w: number, h: number, c: string) => { g.fillStyle = c; g.fillRect(x, y, w, h); };
    const glyph = (rows: string[], x: number, y: number, c: string) => rows.forEach((r, j) => [...r].forEach((b, i) => { if (b === '1') px(x + i, y + j, 1, 1, c); }));
    const box = (x: number, y: number, w: number, h: number, fill: string) => { px(x, y, w, h, C.ink); px(x + 1, y + 1, w - 2, h - 2, fill); };

    function draw() {
      const [dx, dy, dw, dh] = D;
      // dotted yellow wall + pink tiled floor
      px(0, 0, 96, 84, C.yel);
      for (let y = 1; y < 74; y += 4) for (let x = (y % 8 === 1 ? 1 : 3); x < 96; x += 4) px(x, y, 1, 1, C.yel2);
      px(0, 74, 96, 10, C.pink); px(0, 74, 96, 1, C.ink);
      for (let x = 0; x < 96; x += 8) px(x, 75, 1, 9, C.pink2);
      px(0, 79, 96, 1, C.pink2);
      // steel frame
      box(dx - 5, dy - 5, dw + 10, dh + 5, C.g3);
      px(dx - 4, dy - 4, dw + 8, 1, C.g1);
      px(dx - 2, dy - 2, dw + 4, dh + 2, C.g5);
      px(dx - 1, dy - 1, dw + 2, dh + 1, C.g4);
      // cabin behind the doors
      px(dx, dy, dw, dh, C.paper);
      px(dx, dy + dh - 5, dw, 5, C.g3); px(dx, dy, dw, 2, C.g4);
      // doors with diagonal steel reflections
      const L = dw / 2, off = Math.round(open * (L - 1));
      g.save(); g.beginPath(); g.rect(dx, dy, dw, dh); g.clip();
      ([[dx - off, 1], [dx + L + off, -1]] as const).forEach(([x0, side]) => {
        for (let r = 0; r < dh; r++) for (let c = 0; c < L; c++) {
          const k = (c + Math.floor(r * 0.6) + (side > 0 ? 0 : 7)) % 22;
          px(x0 + c, dy + r, 1, 1, k < 3 ? C.g1 : k < 5 ? C.paper : C.g2);
        }
        px(side > 0 ? x0 + L - 1 : x0, dy, 1, dh, C.g5);
        px(x0, dy + dh - 3, L, 3, C.g3);
      });
      g.restore();
      // floor indicator
      box(40, 4, 17, 9, C.ink);
      if (wip) glyph(DIG[0], 47, 6, C.pink);
      else { glyph(DIG[(cur + 1) % 10], 43, 6, C.pink); if (dir) glyph(dir > 0 ? UP : DOWN, 49, 7, C.pink); }
      // call buttons (top: up, bottom: down; both open/close the doors while under construction)
      box(78, 40, 7, 12, C.g2);
      px(80, 42, 3, 3, dir > 0 || pressed > 0 ? C.pink : C.g4); px(80, 47, 3, 3, dir < 0 || pressed < 0 ? C.pink : C.g4);
    }

    function fit() {
      const avail = Math.min(stage.parentElement!.clientWidth, 680);
      const s = Math.max(2, Math.min(7, Math.floor(avail / cv.width)));
      cv.style.width = cv.width * s + 'px'; cv.style.height = cv.height * s + 'px';
      stage.style.setProperty('--s', String(s));
      const [dx, dy, dw, dh] = D;
      Object.assign(room.style, { left: dx * s + 'px', top: dy * s + 'px', width: dw * s + 'px', height: dh * s + 'px' });
      calls.forEach(b => {
        const top = Number(b.dataset.call) > 0 ? 40 : 46;
        Object.assign(b.style, { left: 78 * s + 'px', top: top * s + 'px', width: 7 * s + 'px', height: 6 * s + 'px' });
      });
    }

    function fillRoom() {
      room.innerHTML = wip
        ? '<span class="elev-big">under construction</span><span class="elev-small">(this is a parisian elevator)</span>'
        : `<span class="elev-num">${String(cur + 1).padStart(2, '0')}</span><span class="elev-big">${esc(floors[cur].heading)}</span>`;
    }
    function fillPanel() {
      if (!panel) return;
      const f = floors[cur];
      panel.querySelector('[data-p-sub]')!.textContent = `floor ${String(cur + 1).padStart(2, '0')} · ${f.subheading}`;
      panel.querySelector('[data-p-head]')!.textContent = f.heading;
      panel.querySelector('[data-p-text]')!.textContent = f.text;
      panel.querySelector('[data-p-file]')!.textContent = f.image ? f.image.split('/').pop()! : `floor-${cur + 1}.jpg`;
      panel.querySelector('[data-p-pic]')!.innerHTML = f.image
        ? `<img src="${esc(f.image)}" alt="${esc(f.imageAlt)}" loading="lazy" />`
        : '<span>picture goes here</span>';
    }
    function sync() {
      dirBtns.forEach(b => { b.disabled = (Number(b.dataset.dir) > 0 ? cur === N - 1 : cur === 0); });
      if (status) status.textContent = `floor ${cur + 1}`;
    }

    async function openDoors() { fillRoom(); await tween(800, k => { open = k; draw(); }); room.classList.add('show'); }
    async function closeDoors() { room.classList.remove('show'); await tween(700, k => { open = 1 - k; draw(); }); }

    async function go(t: number) {
      if (wip || busy || t < 0 || t >= N || t === cur) return; busy = true;
      dir = t > cur ? 1 : -1;
      panel?.classList.add('fading');
      if (status) status.textContent = 'going ' + (dir > 0 ? 'up' : 'down');
      await closeDoors();
      while (cur !== t) { await wait(380); cur += dir; draw(); }
      await wait(250); dir = 0; fillPanel(); panel?.classList.remove('fading');
      await openDoors(); sync(); busy = false;
    }
    // While under construction, the wall buttons just open and close the doors
    async function toggleDoors(which: number) {
      if (busy) return; busy = true;
      pressed = which; draw();
      if (open > 0.5) await closeDoors(); else await openDoors();
      pressed = 0; draw(); busy = false;
    }

    dirBtns.forEach(b => b.addEventListener('click', () => go(cur + Number(b.dataset.dir))));
    calls.forEach(b => b.addEventListener('click', () => {
      const which = Number(b.dataset.call);
      if (wip) toggleDoors(which); else go(cur + which);
    }));

    fillPanel(); sync(); draw(); fit();
    addEventListener('resize', fit);

    // Doors stay closed until the elevator is on screen, then open after 2 seconds
    let started = false;
    const check = async () => {
      if (started) return;
      const r = stage.getBoundingClientRect();
      const visible = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
      if (visible < r.height * 0.4) return;
      started = true;
      removeEventListener('scroll', check);
      await wait(2000);
      await openDoors();
      busy = false;
    };
    addEventListener('scroll', check, { passive: true });
    check();
  });
</script>
