<section class="section yellow hero" id="home">
  <span class="vert" aria-hidden="true">aGkgdGhlcmUuIHdlbGNvbWUgdG8gbXkgYnJhaW4u</span>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1 class="mega hero-title">hi there. welcome to my brain.</h1>
      <p class="lede">i wanted to have my own corner of the internet so i vibe coded this page.</p>
      <div class="win bug-banner" role="note" id="bugBanner">
        <div class="bar"><span>System Message</span><span>!</span></div>
