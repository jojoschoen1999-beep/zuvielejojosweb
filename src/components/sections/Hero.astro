<script>
  document.querySelectorAll('[data-close-banner]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const banner = document.getElementById('bugBanner');
      if (!banner) return;
      banner.classList.add('closing');
      setTimeout(() => banner.remove(), 180);
    });
  });
</script>
