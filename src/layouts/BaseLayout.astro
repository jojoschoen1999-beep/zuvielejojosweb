---
import '../styles/global.css';
interface Props {
  title: string;
  onePage?: boolean;
  noindex?: boolean;
}
const { title, onePage = false, noindex = false } = Astro.props;
// On the home page the nav scrolls to sections; elsewhere it jumps back to them.
const base = onePage ? '' : '/';
const navRight = [
  { id: 'thoughts', label: 'thoughts' },
  { id: 'elevator-pitch', label: 'elevator pitch' },
  { id: 'pick-my-brain', label: 'pick my brain' },
  { id: 'about', label: 'about' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} — ZUVIELEJOJOS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <header class="header">
      <nav class="nav nav-left" aria-label="Home">
        <a href={onePage ? '#home' : '/'} class="chip" data-nav="home">home</a>
      </nav>
      <a href={onePage ? '#home' : '/'} class="brand-wrap" id="brandWrap">
        <span class="brand-star">✦</span>
        <span class="brand-star">✧</span>
        <span class="brand-star">✦</span>
        <span class="brand-star">✧</span>
        <span class="brand-star">✦</span>
        <span class="brand-star">✧</span>
        <span class="brand">ZUVIELEJOJOS</span>
      </a>
      <nav class="nav nav-right" aria-label="Sections">
        {navRight.map((l) => (
          <a href={`${base}#${l.id}`} class="chip" data-nav={l.id}>{l.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap stack">
        <div class="glyph" aria-hidden="true"><span>✦ ✧</span><span>✧ ✦</span></div>
        <div class="spark-zone">
          <div class="foot-mark-wrap" aria-hidden="true" id="sparkHover">
            <span class="spark" style="left:2%;top:8%;font-size:30px;animation-delay:0s">✦</span>
            <span class="spark p" style="left:9%;top:70%;font-size:22px;animation-delay:0.6s">✧</span>
            <span class="spark w" style="left:16%;top:18%;font-size:18px;animation-delay:1.2s">✦</span>
            <span class="spark" style="left:24%;top:82%;font-size:26px;animation-delay:0.3s">✧</span>
            <span class="spark p" style="left:33%;top:4%;font-size:20px;animation-delay:1.6s">✦</span>
            <span class="spark w" style="left:46%;top:90%;font-size:18px;animation-delay:0.9s">✧</span>
            <span class="spark" style="left:58%;top:2%;font-size:24px;animation-delay:1.9s">✦</span>
            <span class="spark p" style="left:67%;top:86%;font-size:20px;animation-delay:0.4s">✦</span>
            <span class="spark w" style="left:76%;top:10%;font-size:18px;animation-delay:1.4s">✧</span>
            <span class="spark" style="left:84%;top:74%;font-size:28px;animation-delay:0.7s">✦</span>
            <span class="spark p" style="left:92%;top:22%;font-size:22px;animation-delay:1.1s">✧</span>
            <span class="spark w" style="left:97%;top:64%;font-size:18px;animation-delay:2.1s">✦</span>
            <div class="foot-mark">ZUVIELEJOJOS</div>
          </div>
          <!-- Hidden way to /sparkle: pops up when you move over the sparkles -->
          <div class="win spark-ask" id="sparkAsk" role="dialog" aria-label="System Message" hidden>
            <div class="bar"><span>System Message</span><span>✦</span></div>
            <div class="bd">
              <span>looking for your sparkle?</span>
              <div class="btnrow">
                <a class="wbtn" href="/sparkle">yes</a>
                <button class="wbtn" type="button" id="sparkNo">no</button>
              </div>
            </div>
          </div>
        </div>
        <div class="foot">
          <span>zuvielejojos © {new Date().getFullYear()} · <a href="/privacy">privacy</a> · <a href="/mentions-legales">mentions légales</a></span>
          <span>made in paris. vibe coded with very little patience<span class="blink">_</span></span>
          <span class="foot-links">
            <a href="https://www.instagram.com/zuvielejojos/" target="_blank" rel="noopener noreferrer">instagram</a>
            <a href="https://zuvielejojos.substack.com" target="_blank" rel="noopener noreferrer">substack</a>
            <a href="https://www.linkedin.com/in/johanna-schoen/" target="_blank" rel="noopener noreferrer">linkedin</a>
          </span>
        </div>
      </div>
    </footer>

    <!-- Floating game button (bottom-left, desktop only) -->
    <a href="/snake" class="float-btn snake-float" title="Play Pac-Brain">
      bored?
    </a>
    <!-- Floating IG button (bottom-right) -->
    <a href="https://www.instagram.com/zuvielejojos/" target="_blank" rel="noopener noreferrer" class="float-btn ig-float" title="Instagram">@zuvielejojos</a>

    <!-- Discovery score (desktop only): fills as people scroll and click around, a letter pops up at 100% -->
    <div class="ds" id="ds">
      <span>discovery score</span>
      <div class="ds-bar" aria-hidden="true"><div class="ds-blocks" id="dsBlocks"></div></div>
      <span class="ds-pct" id="dsPct">0%</span>
      <button class="ds-hint" id="dsHint" type="button" tabindex="-1">scroll further to win<i>_</i></button>
    </div>
    <div class="ds-plus" id="dsPlus" aria-hidden="true"></div>
    <button class="ds-letter" id="dsLetter" type="button" aria-label="Open the letter" hidden>
      <svg id="dsEnv" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges" aria-hidden="true"></svg>
      <span class="ds-cap">you've got mail</span>
    </button>
    <div class="win ds-photo" id="dsPhoto" role="dialog" aria-label="jojoklein.png" hidden>
      <div class="bar"><span>jojoklein.png</span><button type="button" id="dsClose" aria-label="Close">&#9634;</button></div>
      <div class="bd"><img src="/images/fanclub.webp" alt="Jojo as a kid in a pink tutu, posing in the kitchen" loading="lazy" /><span>welcome to the fanclub</span></div>
    </div>

    <script>
      // Brand stars on hover
      const brandWrap = document.getElementById('brandWrap');
      if (brandWrap) {
        brandWrap.addEventListener('mouseenter', () => {
          document.querySelectorAll('.brand-star').forEach((s, i) => setTimeout(() => s.classList.add('visible'), i * 80));
        });
        brandWrap.addEventListener('mouseleave', () => {
          document.querySelectorAll('.brand-star').forEach(s => s.classList.remove('visible'));
        });
      }

      // Sparkles in the footer: moving over them pops up "looking for your sparkle?" where the pointer is
      const sparkHover = document.getElementById('sparkHover');
      const sparkAsk = document.getElementById('sparkAsk');
      let sparkAsked = false;
      if (sparkHover && sparkAsk) {
        sparkHover.addEventListener('pointerenter', (e) => {
          if (sparkAsked) return;
          sparkAsked = true;
          const zone = sparkHover.getBoundingClientRect();
          const half = Math.min(150, zone.width / 2);
          sparkAsk.style.left = Math.max(half, Math.min(zone.width - half, e.clientX - zone.left)) + 'px';
          sparkAsk.hidden = false;
        });
        document.getElementById('sparkNo')?.addEventListener('click', () => { sparkAsk.hidden = true; });
      }

      // Highlight the nav chip of the section you're looking at
      const sections = document.querySelectorAll<HTMLElement>('main > section[id]');
      const chips = document.querySelectorAll<HTMLElement>('[data-nav]');
      const setActive = (id: string) => chips.forEach(c => c.classList.toggle('active', c.dataset.nav === id));
      if (sections.length) {
        const update = () => {
          // The active section is the last one whose top has passed a line a third down the screen
          const line = window.innerHeight * 0.33;
          let current = sections[0].id;
          sections.forEach(s => { if (s.getBoundingClientRect().top <= line) current = s.id; });
          setActive(current);
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }
    </script>

    <script>
      // Discovery score: what counts and how much (adds up to 100). Saved in this browser only.
      const FINDS: Record<string, number> = {
        thoughts: 10, 'elevator-pitch': 10, 'pick-my-brain': 10, about: 10, footer: 10,
        bored: 10, privacy: 20, mentions: 20,
      };
      const KEY = 'zj-discovery', MAIL = 'zj-discovery-mail';
      const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
      const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
      let found = new Set<string>();
      try { found = new Set((JSON.parse(read(KEY) || '[]') as string[]).filter(k => k in FINDS)); } catch {}

      const blocks = document.getElementById('dsBlocks')!;
      for (let i = 0; i < 50; i++) blocks.appendChild(document.createElement('i'));
      const ds = document.getElementById('ds')!, hint = document.getElementById('dsHint')!;
      const letter = document.getElementById('dsLetter')!, photo = document.getElementById('dsPhoto')!;
      const env = document.getElementById('dsEnv')!;
      const total = () => [...found].reduce((s, k) => s + FINDS[k], 0);

      function render() {
        const pct = Math.min(100, total());
        document.getElementById('dsPct')!.textContent = pct + '%';
        [...blocks.children].forEach((b, i) => b.classList.toggle('on', i < Math.floor(pct / 2)));
        const won = pct >= 100;
        ds.classList.toggle('won', won);
        hint.innerHTML = won ? (read(MAIL) ? 'you won ✦ open your mail' : 'you won ✦ check your mail') : 'scroll further to win<i>_</i>';
        if (won && !read(MAIL) && letter.hidden && photo.hidden) setTimeout(() => { drawEnvelope(false); letter.hidden = false; }, 700);
      }
      function score(k: string) {
        if (found.has(k) || !(k in FINDS)) return;
        found.add(k); write(KEY, JSON.stringify([...found])); render();
        const plus = document.getElementById('dsPlus')!;
        plus.textContent = `+${FINDS[k]}%`; plus.classList.remove('go'); void plus.offsetWidth; plus.classList.add('go');
      }

      // Pixel envelope drawn on a grid, so the diagonals step like real pixel art.
      // Areas: 1 inside (pink), 2 letter (paper), 3 body (yellow), 4 flap (pink). Ink lines go where an area meets a lower one.
      const COL: Record<number, string> = { 1: 'var(--pink)', 2: 'var(--paper)', 3: 'var(--yellow)', 4: 'var(--pink)' };
      function drawEnvelope(open: boolean) {
        const Wd = 24, top = open ? 9 : 0, H = top + 16, cx = 11.5, grid: number[] = [];
        for (let y = 0; y < H; y++) for (let x = 0; x < Wd; x++) {
          const d = Math.abs(x - cx), yy = y - top, inLetter = x >= 4 && x <= 19 && y >= top - 5;
          let z = 0;
          if (y >= top) {
            if (!open) z = yy <= 8 * (1 - d / cx) ? 4 : 3;
            else z = yy >= 8 * (1 - d / cx) + 1 ? 3 : inLetter ? 2 : 1;
          } else if (open) {
            if (y > top - top * (1 - d / cx) - .5) z = 4;
            if (inLetter) z = 2;
          }
          grid.push(z);
        }
        const at = (x: number, y: number) => (x < 0 || y < 0 || x >= Wd || y >= H) ? 0 : grid[y * Wd + x];
        const px = (x: number, y: number, c: string) => `<rect x="${x}" y="${y}" width="1" height="1" fill="${c}"/>`;
        let r = '';
        for (let y = 0; y < H; y++) for (let x = 0; x < Wd; x++) {
          const z = at(x, y); if (!z) continue;
          const edge = [[1, 0], [-1, 0], [0, 1], [0, -1]].some(([dx, dy]) => { const n = at(x + dx, y + dy); return n === 0 || n < z; });
          r += px(x, y, edge ? 'var(--ink)' : COL[z]);
        }
        const heart = (hx: number, hy: number, c: string) => [[1,0],[3,0],[0,1],[1,1],[2,1],[3,1],[4,1],[1,2],[2,2],[3,2],[2,3]].map(([a, b]) => px(hx + a, hy + b, c)).join('');
        if (open) {
          r += heart(6, top - 3, COL[1]);
          [[12, 18, top - 3], [12, 17, top - 1], [6, 18, top + 1], [6, 16, top + 3]].forEach(([x1, x2, yy]) => {
            for (let x = x1; x <= x2; x++) if ((x * 7 + yy) % 6 !== 0 && at(x, yy) === 2) r += px(x, yy, 'var(--ink)');
          });
        } else r += heart(10, 5, 'var(--ink)');
        env.setAttribute('viewBox', `0 0 ${Wd} ${H}`);
        env.innerHTML = r;
      }

      function showPhoto() { letter.hidden = true; photo.hidden = false; }
      letter.addEventListener('click', () => {
        drawEnvelope(true); letter.classList.add('open');
        letter.querySelector('.ds-cap')!.textContent = 'for you';
        write(MAIL, '1');
        setTimeout(showPhoto, 450);
      });
      document.getElementById('dsClose')!.addEventListener('click', () => { photo.hidden = true; render(); });
      hint.addEventListener('click', () => { if (total() >= 100) showPhoto(); });

      // Scrolling: a home section counts once its top reaches the lower third of the screen; the footer once it shows up
      const checkScroll = () => {
        document.querySelectorAll<HTMLElement>('main > section[id]').forEach(s => { if (s.getBoundingClientRect().top < innerHeight * 0.7) score(s.id); });
        const foot = document.querySelector('.footer');
        if (foot && foot.getBoundingClientRect().top < innerHeight * 0.9) score('footer');
      };
      addEventListener('scroll', checkScroll, { passive: true });

      // Pages that count just by being opened
      const path = location.pathname.replace(/\/$/, '');
      if (path === '/privacy') score('privacy');
      if (path === '/mentions-legales') score('mentions');
      if (path === '/snake') score('bored');

      render();
      checkScroll();
    </script>
  </body>
</html>
