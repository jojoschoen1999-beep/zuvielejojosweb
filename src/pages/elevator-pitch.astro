---
import BaseLayout from '../layouts/BaseLayout.astro';
// Placeholder for now. The elevator prototype from Sep 30 is still in
// src/components/Elevator.astro and src/data/elevatorPitch.ts for later.
---

<BaseLayout title="Elevator pitch" activeNav="/elevator-pitch" band="yellow">
  <section class="page">
    <div class="wrap stack">
      <div class="crop"><i class="c1"></i><i class="c2"></i><h1 class="mega md">ELEVATOR PITCH</h1></div>
      <div class="grid">
        <div class="s5">
          <div class="win">
            <div class="bar"><span>elevator.pitch 0.1</span><span>▢</span></div>
            <div class="bd">
              <span>Loading ...</span>
              <span>floor 0 of 6</span>
              <div class="prog" aria-hidden="true"><i style="width:12%">12%</i></div>
            </div>
          </div>
        </div>
        <div class="col s7">
          <span class="lbl">under construction</span>
          <p class="lede">this page is still being built. come back soon.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
