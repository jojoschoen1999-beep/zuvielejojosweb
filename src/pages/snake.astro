---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pac-Brain">
  <section class="page">
    <div class="wrap stack">
      <div class="crop"><i class="c1"></i><i class="c2"></i><h1 class="mega md">in case you're bored:</h1></div>
      <div class="win snake-win">
        <div class="bar"><span>pac-brain 1.0</span><span>▢</span></div>
        <div class="bd">
          <div class="shot"><canvas id="snakeCanvas" class="snake-canvas" width="400" height="400"></canvas></div>
          <div class="snake-meta"><span>score: <span id="snakeScore">0</span> &middot; lives: <span id="brainLives">3</span></span><span>arrow keys / swipe to play &middot; space to restart</span></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    type Vec = { x: number; y: number };
    type Ghost = { x: number; y: number; px: number; py: number; dir: Vec; color: string; state: 'home' | 'out'; releaseAt: number };

    // Left half of the maze, mirrored to 20 columns. # wall, . dot, o power dot, = ghost door, G ghost house
    const HALF = [
      '##########', '#........#', '#o##.###.#', '#.........', '#.##.#.###',
      '#....#...#', '####.###.#', '####.#....', '####.#.##=', '.....#.#GG',
      '####.#.###', '####.#....', '####.#.###', '#........#', '#.##.###.#',
      '#o.#......', '##.#.#.###', '#....#...#', '#.........', '##########',
    ];
    const MAZE = HALF.map(r => r + r.split('').reverse().join(''));
    const DIRS: Vec[] = [{ x: 1, y: 0 }, { x: -1, y: 0 }, { x: 0, y: 1 }, { x: 0, y: -1 }];
    const START: Vec = { x: 9, y: 15 };
    const DOOR_EXIT: Vec = { x: 9, y: 7 };
    const TICK = 140;

    let rafId: number | undefined;

    function initGame() {
      const canvas = document.getElementById('snakeCanvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;
      const size = 20, cols = 20, rows = 20;
      const scoreEl = document.getElementById('snakeScore')!;
      const livesEl = document.getElementById('brainLives')!;

      let dots: string[][] = [];
      let score = 0, lives = 3, level = 1;
      let state: 'play' | 'dead' | 'over' | 'won' = 'play';
      let player = { ...START, px: START.x, py: START.y };
      let dir: Vec = { x: 0, y: 0 }, nextDir: Vec = { x: -1, y: 0 }, facing: Vec = { x: -1, y: 0 };
      let ghosts: Ghost[] = [];
      let frightUntil = 0, ghostCombo = 0, tick = 0, lastTick = 0, pauseUntil = 0;

      const wrap = (x: number) => ((x % cols) + cols) % cols;
      const isWall = (x: number, y: number, ghostLeaving = false) => {
        if (y < 0 || y >= rows) return true;
        const c = MAZE[y][wrap(x)];
        return c === '#' || (c === '=' && !ghostLeaving);
      };

      function resetDots() {
        dots = MAZE.map(r => r.split('').map(c => (c === '.' || c === 'o' ? c : ' ')));
        dots[START.y][START.x] = ' ';
      }

      function resetActors(now: number) {
        player = { ...START, px: START.x, py: START.y };
        dir = { x: 0, y: 0 }; nextDir = { x: -1, y: 0 }; facing = { x: -1, y: 0 };
        const colors = ['#1E1E1E', '#6E8BFF', '#FF9F43', '#3BB273'];
        ghosts = colors.map((color, i) => {
          const x = 8 + i, y = 9;
          return { x, y, px: x, py: y, dir: { x: 0, y: -1 }, color, state: 'home', releaseAt: now + 600 + i * 2500 / level };
        });
        frightUntil = 0;
        pauseUntil = now + 900;
      }

      // smart = chance the ghost heads straight for its target instead of wandering
      function choose(g: Ghost, target: Vec, smart: number, leaving: boolean) {
        const options = DIRS.filter(d => !(d.x === -g.dir.x && d.y === -g.dir.y) && !isWall(g.x + d.x, g.y + d.y, leaving));
        const pool = options.length ? options : DIRS.filter(d => !isWall(g.x + d.x, g.y + d.y, leaving));
        if (!pool.length) return g.dir;
        if (Math.random() < smart) {
          const dist = (v: Vec) => Math.hypot(wrap(g.x + v.x) - target.x, g.y + v.y - target.y);
          return pool.reduce((best, d) => (dist(d) < dist(best) ? d : best));
        }
        return pool[Math.floor(Math.random() * pool.length)];
      }

      function collide(now: number) {
        for (const g of ghosts) {
          const swapped = g.px === player.x && g.py === player.y && player.px === g.x && player.py === g.y;
          if (g.state !== 'out' || !((g.x === player.x && g.y === player.y) || swapped)) continue;
          if (now < frightUntil) {
            ghostCombo++;
            score += 50 * 2 ** ghostCombo;
            Object.assign(g, { x: 9, y: 9, px: 9, py: 9, state: 'home', releaseAt: now + 3000, dir: { x: 0, y: -1 } });
          } else {
            lives--;
            livesEl.textContent = String(lives);
            state = lives > 0 ? 'dead' : 'over';
            pauseUntil = now + 1200;
            return;
          }
        }
      }

      function step(now: number) {
        tick++;
        player.px = player.x; player.py = player.y;
        if (!isWall(player.x + nextDir.x, player.y + nextDir.y)) dir = nextDir;
        if (!isWall(player.x + dir.x, player.y + dir.y)) {
          player.x = wrap(player.x + dir.x); player.y += dir.y;
          if (dir.x || dir.y) facing = dir;
        }
        const d = dots[player.y][player.x];
        if (d === '.') score += 10;
        if (d === 'o') { score += 50; frightUntil = now + Math.max(2500, 7000 - level * 800); ghostCombo = 0; }
        dots[player.y][player.x] = ' ';
        collide(now);
        if (state !== 'play') return;

        // ghosts move at half speed while scared
        const scared = now < frightUntil;
        for (const g of ghosts) {
          g.px = g.x; g.py = g.y;
          if (g.state === 'home') {
            if (now < g.releaseAt) continue;
            g.dir = choose(g, DOOR_EXIT, 1, true);
            g.x += g.dir.x; g.y += g.dir.y;
            if (g.y <= DOOR_EXIT.y) g.state = 'out';
            continue;
          }
          if (scared && tick % 2) continue;
          g.dir = choose(g, player, scared ? 0 : Math.min(0.85, 0.45 + level * 0.1), false);
          g.x = wrap(g.x + g.dir.x); g.y += g.dir.y;
        }
        collide(now);

        if (!dots.some(r => r.some(c => c !== ' '))) { state = 'won'; pauseUntil = now + 1500; }
      }

      function drawBrain(cx: number, cy: number, t: number) {
        const r = 9;
        const open = (Math.sin(t / 70) + 1) / 2 * 0.7 + 0.05;
        ctx.save();
        ctx.translate(cx, cy);
        if (facing.x < 0) ctx.scale(-1, 1);
        else if (facing.y) ctx.rotate(facing.y * Math.PI / 2);
        // the chomping mouth is cut out of the brain like a pac-man wedge
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, r + 2, open, Math.PI * 2 - open);
        ctx.closePath();
        ctx.clip();
        ctx.fillStyle = '#F386A1';
        ctx.strokeStyle = '#C94F70';
        ctx.lineWidth = 1;
        const lumps: [number, number, number][] = [[-4, -3, 5], [1, -4.5, 5], [5, -1.5, 4.5], [3.5, 3.5, 5], [-1.5, 4.5, 4.5], [-5, 1.5, 4.5]];
        ctx.beginPath();
        lumps.forEach(([x, y, lr]) => { ctx.moveTo(x + lr, y); ctx.arc(x, y, lr, 0, Math.PI * 2); });
        ctx.fill();
        lumps.forEach(([x, y, lr]) => { ctx.beginPath(); ctx.arc(x, y, lr, 0, Math.PI * 2); ctx.stroke(); });
        // folds
        ctx.beginPath();
        ctx.moveTo(-6, -1); ctx.quadraticCurveTo(-3, -4, -1, -1); ctx.quadraticCurveTo(1, 2, 4, -2);
        ctx.moveTo(-5, 4); ctx.quadraticCurveTo(-2, 2, 0, 5);
        ctx.moveTo(-1, -6); ctx.quadraticCurveTo(0, -3, 3, -5);
        ctx.stroke();
        // tiny eye
        ctx.fillStyle = '#1E1E1E';
        ctx.beginPath(); ctx.arc(2, -4, 1.3, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      }

      function drawGhost(g: Ghost, cx: number, cy: number, now: number) {
        const scared = now < frightUntil && g.state === 'out';
        const flash = scared && frightUntil - now < 1500 && Math.floor(now / 200) % 2;
        const r = 8;
        ctx.fillStyle = scared ? (flash ? '#FFFCB8' : '#F9C4D2') : g.color;
        ctx.strokeStyle = '#1E1E1E';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(cx, cy - 1, r, Math.PI, 0);
        ctx.lineTo(cx + r, cy + r);
        const wob = Math.floor(now / 150) % 2 ? 1.5 : -1.5;
        for (let i = 0; i < 4; i++) {
          const x0 = cx + r - (i + 1) * (r / 2);
          ctx.lineTo(x0 + r / 4, cy + r - 3 + (i % 2 ? wob : -wob));
          ctx.lineTo(x0, cy + r);
        }
        ctx.closePath();
        ctx.fill();
        if (scared) ctx.stroke();
        // eyes look where the ghost is going
        ctx.fillStyle = '#FFFCB8';
        [-3, 3].forEach(ox => { ctx.beginPath(); ctx.arc(cx + ox, cy - 2, 2.5, 0, Math.PI * 2); ctx.fill(); });
        ctx.fillStyle = '#1E1E1E';
        [-3, 3].forEach(ox => { ctx.beginPath(); ctx.arc(cx + ox + g.dir.x * 1.2, cy - 2 + g.dir.y * 1.2, 1.2, 0, Math.PI * 2); ctx.fill(); });
      }

      // smooth movement between grid ticks; snap instead of sliding when wrapping through the tunnel or respawning
      const lerp = (a: number, b: number, k: number) => (Math.abs(a - b) > 1 ? b : a + (b - a) * k);

      function draw(now: number) {
        const k = Math.min(1, (now - lastTick) / TICK);
        ctx.fillStyle = '#FFFCB8';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const c = MAZE[y][x];
            if (c === '#') {
              ctx.fillStyle = '#1E1E1E';
              ctx.fillRect(x * size + 2, y * size + 2, size - 4, size - 4);
              // join neighbouring wall blocks so the maze reads as corridors
              if (x + 1 < cols && MAZE[y][x + 1] === '#') ctx.fillRect(x * size + size - 2, y * size + 2, 4, size - 4);
              if (y + 1 < rows && MAZE[y + 1][x] === '#') ctx.fillRect(x * size + 2, y * size + size - 2, size - 4, 4);
              if (x + 1 < cols && y + 1 < rows && MAZE[y][x + 1] === '#' && MAZE[y + 1][x] === '#' && MAZE[y + 1][x + 1] === '#') ctx.fillRect(x * size + size - 2, y * size + size - 2, 4, 4);
            } else if (c === '=') {
              ctx.fillStyle = '#F386A1';
              ctx.fillRect(x * size, y * size + size / 2 - 2, size, 4);
            }
            const d = dots[y][x];
            if (d === '.') { ctx.fillStyle = '#1E1E1E'; ctx.fillRect(x * size + 8, y * size + 8, 4, 4); }
            if (d === 'o' && Math.floor(now / 250) % 2) { ctx.fillStyle = '#F386A1'; ctx.beginPath(); ctx.arc(x * size + 10, y * size + 10, 5, 0, Math.PI * 2); ctx.fill(); }
          }
        }
        ghosts.forEach(g => drawGhost(g, lerp(g.px, g.x, k) * size + size / 2, lerp(g.py, g.y, k) * size + size / 2, now));
        if (state !== 'over') drawBrain(lerp(player.px, player.x, k) * size + size / 2, lerp(player.py, player.y, k) * size + size / 2, now);

        const banner = state === 'over' ? 'game over' : state === 'won' ? 'big brain!' : now < pauseUntil && state === 'play' ? 'ready?' : '';
        if (banner) {
          if (state === 'over') { ctx.fillStyle = 'rgba(30,30,30,0.85)'; ctx.fillRect(0, 0, canvas.width, canvas.height); }
          ctx.fillStyle = state === 'over' ? '#FFFCB8' : '#F386A1';
          ctx.font = '36px VT323, monospace';
          ctx.textAlign = 'center';
          ctx.fillText(banner, canvas.width / 2, state === 'over' ? canvas.height / 2 - 10 : 14 * size - 4);
          if (state === 'over') {
            ctx.font = '20px VT323, monospace';
            ctx.fillText('press space to restart', canvas.width / 2, canvas.height / 2 + 20);
          }
        }
      }

      function loop(now: number) {
        if (now >= pauseUntil) {
          if (state === 'dead') { state = 'play'; resetActors(now); }
          else if (state === 'won') { state = 'play'; level++; resetDots(); resetActors(now); }
          else if (state === 'play' && now - lastTick >= TICK) { step(now); lastTick = now; scoreEl.textContent = String(score); }
        }
        draw(now);
        rafId = requestAnimationFrame(loop);
      }

      const turn = (key: string) => {
        if (key === 'ArrowUp') nextDir = { x: 0, y: -1 };
        if (key === 'ArrowDown') nextDir = { x: 0, y: 1 };
        if (key === 'ArrowLeft') nextDir = { x: -1, y: 0 };
        if (key === 'ArrowRight') nextDir = { x: 1, y: 0 };
      };

      document.onkeydown = (e) => {
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) e.preventDefault();
        turn(e.key);
        if (e.key === ' ') initGame();
      };

      let touchStart: Vec | null = null;
      canvas.ontouchstart = (e) => { touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY }; e.preventDefault(); };
      canvas.ontouchend = (e) => {
        if (!touchStart) return;
        const dx = e.changedTouches[0].clientX - touchStart.x, dy = e.changedTouches[0].clientY - touchStart.y;
        touchStart = null;
        if (Math.max(Math.abs(dx), Math.abs(dy)) < 12) { if (state === 'over') initGame(); return; }
        turn(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'ArrowRight' : 'ArrowLeft') : (dy > 0 ? 'ArrowDown' : 'ArrowUp'));
      };

      if (rafId) cancelAnimationFrame(rafId);
      scoreEl.textContent = '0';
      livesEl.textContent = '3';
      const now = performance.now();
      resetDots();
      resetActors(now);
      lastTick = now;
      rafId = requestAnimationFrame(loop);
    }

    initGame();
  </script>
</BaseLayout>
