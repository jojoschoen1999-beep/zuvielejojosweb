---
import BaseLayout from '../layouts/BaseLayout.astro';
// Shown for any link that doesn't exist. Astro sends it with a 404 status.
---

<BaseLayout title="Page not found">
  <section class="page nf">
    <div class="wrap nf-grid">
      <div class="nf-text">
        <h1 class="mega nf-code">404</h1>
        <p class="h2">page not found.</p>
        <p class="lede">you found the one corner of my brain that doesn't exist (yet).</p>
        <div class="nf-actions">
          <a href="/" class="chip solid lg">take me home</a>
          <a href="/#pick-my-brain" class="chip lg">pick my brain instead</a>
        </div>
      </div>

      <div class="nf-desk" id="nfDesk">
        <div class="win nf-photo nf-pop">
          <div class="bar"><span>mirror_selfie.jpg - 404 1.1</span><span>▢</span></div>
          <div class="bd"><div class="shot"><img src="/images/404-mirror.jpg" alt="Jojo's face, blurry in a round make-up mirror" width="900" height="879" /></div></div>
        </div>
        <div class="win nf-error nf-pop">
          <div class="bar"><span>System Message</span><span>!</span></div>
          <div class="bd">
            <span>error 404: this page does not exist.</span>
            <div class="btnrow"><button class="wbtn" type="button" data-nf-ok>ok</button></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Every "ok" opens another error message, like an old computer that won't give up.
  const lines = [
    'are you sure? there is really nothing here.',
    'still nothing.',
    'ok you can stop clicking now.',
    'fine. have a sparkle ✦',
    'that was the last one. go home <3',
  ];
  const desk = document.getElementById('nfDesk');
  let shown = 0;

  function open(text: string, last: boolean) {
    if (!desk) return;
    const win = document.createElement('div');
    win.className = 'win nf-error nf-pop';
    // each new message lands a bit lower and further left (phones: alternating sides)
    win.style.setProperty('--x', `${(shown + 1) * 3}%`);
    win.style.setProperty('--y', `${(shown + 1) * 7}%`);
    win.style.setProperty('--side', shown % 2 ? 'end' : 'start');
    win.innerHTML = `<div class="bar"><span>System Message ${shown + 2}</span><span>!</span></div><div class="bd"><span></span><div class="btnrow"></div></div>`;
    win.querySelector('.bd > span')!.textContent = text;
    const row = win.querySelector('.btnrow')!;
    if (last) {
      const home = document.createElement('a');
      home.className = 'wbtn'; home.href = '/'; home.textContent = 'home';
      row.append(home);
    } else {
      const ok = document.createElement('button');
      ok.className = 'wbtn'; ok.type = 'button'; ok.textContent = 'ok';
      ok.addEventListener('click', next);
      row.append(ok);
    }
    desk.append(win);
  }

  function next() {
    if (shown >= lines.length) return;
    open(lines[shown], shown === lines.length - 1);
    shown++;
  }

  document.querySelector('[data-nf-ok]')?.addEventListener('click', next);
</script>
